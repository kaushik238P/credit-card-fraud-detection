# Project name for container grouping
PROJECT_NAME=Enterprise Credit Card Fraud Detection

# Debug flag and logging configuration
DEBUG=True
LOG_LEVEL=INFO

# Storage directories configuration
MODEL_DIR=artifacts/models
DATA_DIR=data

# Secret authorization key used to secure backend predictions
FRAUD_API_KEY=test_api_key_123

# MLflow tracking connection configurations
MLFLOW_TRACKING_URI=http://localhost:5000

# Inference Offline Mode Configuration
# Set to 'true' to completely bypass MLflow tracking connections at runtime 
# and load pre-trained model/encoding assets directly from local storage.
FRAUD_INFERENCE_OFFLINE_MODE=true
