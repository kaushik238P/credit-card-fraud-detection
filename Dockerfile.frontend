# Stage 1: Build virtual environment using uv
FROM python:3.12-slim-bookworm AS builder

# Copy uv binary from the official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy only the files needed for dependency resolution
COPY pyproject.toml uv.lock ./

# Install dependencies using uv sync (including frontend extra)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra frontend

# Stage 2: Optimized final runtime image
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

# Copy the virtual environment from the builder stage
COPY --from=builder /app/.venv /app/.venv

# Update PATH to prioritize virtual environment binaries
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Copy only the directories required for frontend runtime

COPY frontend/ frontend/

# Setup non-root user and assign permissions
RUN groupadd -r app && useradd -r -g app app && chown -R app:app /app

# Run container as non-root user
USER app

# Expose Streamlit port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/')"

# Default to running the Streamlit frontend
CMD ["streamlit", "run", "frontend/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]